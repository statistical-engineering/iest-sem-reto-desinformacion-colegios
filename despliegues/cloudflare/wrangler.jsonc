/*
 * Configuración del Worker del reto en Cloudflare (U1, corte delgado).
 * Decisiones: aidlc/spaces/default/intents/261024-publicar-reto-nube/construction/u1-cloudflare-corte/decisions.md
 * (ADR-W1 a ADR-W5) e infrastructure-design/infrastructure-specification.md («Piezas»).
 * La clave del semillero NO va aquí: es el secreto CLAVE_SEMILLERO
 * (npx wrangler@4.148.0 secret put CLAVE_SEMILLERO; en local, el archivo .dev.vars, que no se versiona).
 */
{
  "name": "reto-desinformacion",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RETO", "class_name": "Reto" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reto"] }]
}
